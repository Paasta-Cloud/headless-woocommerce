# نشانی عمومی وردپرس، بدون اسلش پایانی. برای حالت نمایشی خالی بگذارید.
WOOCOMMERCE_URL=demo
# فقط پس از تنظیم روش تحویل و پرداخت در ووکامرس و آزمون سفارش فعال کنید.
STORE_CHECKOUT_ENABLED=false
# در حالت آزمایشی زیبال، پرداخت واقعی انجام نمی‌شود.
ZIBAL_SANDBOX=true
# نشانی تحویل حضوری که در صورت‌حساب نمایش داده می‌شود.
STORE_PICKUP_ADDRESS=
